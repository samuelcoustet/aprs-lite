# aprs-aioc-relay-lite — Configuration exemple
# Copier en config.env et adapter

# Station
CALLSIGN="F0CALL"
LAT="48.8566"
LON="2.3522"
COMMENT="iGate APRS"
PASSCODE="00000"

# Radio (AIOC — All-In-One Cable)
TXDELAY="50"
ADEVICE="plughw:AllInOneCable,0"
PTT="CM108 /dev/hidraw0"
ARATE="48000"

# iGate APRS-IS
IGSERVER="rotate.aprs2.net"
IGFILTER_KM="200"

# Capteur météo BME280 / BME680 / BME688
SENSOR_ENABLED="1"
SENSOR_TX_APRS="1"
SENSOR_INTERVAL="10"
SENSOR_I2C_ADDR="auto"
