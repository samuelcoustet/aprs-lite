# aprs-aioc-relay-lite — Configuration
# Modifiable via le TUI (touche C) ou directement

# Station
CALLSIGN="F5ZVO"
PASSCODE="8321"
LAT="42.978539"
LON="-0.749317"
COMMENT="ARPA 64 - Relais APRS La Pierre St-Martin 1670m"

# Radio
TXDELAY="50"
ADEVICE="plughw:AllInOneCable,0"
PTT="CM108 /dev/hidraw0"
ARATE="48000"

# iGate
IGSERVER="euro.aprs2.net"
IGFILTER_KM="200"

# Logs
LOG_DIR="/opt/aprs-lite/logs"
USB_MOUNT="/mnt/usb"
LOG_RETENTION_DAYS="180"

# Watchdog
REBOOT_DAY="sunday"
REBOOT_HOUR="03:00"

# Site isolé
# SITE_MODE=isolated  → pas de ping internet, statut "Mode isolé" dans TUI
# SITE_MODE=online    → comportement normal avec vérification internet
SITE_MODE="online"
TEMP_WARN="75"
DISK_WARN_PCT="90"
ALTITUDE_M="1670"
SENSOR_INTERVAL="30"
